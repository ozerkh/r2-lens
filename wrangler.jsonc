{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-lens",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
